# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# The bakery photo archive (public/archive) IS committed. It looks like build
# output but is not: the originals are 3000x4000 camera files in a folder on one
# laptop, so nobody else can run ingest-archive.mjs to regenerate these. Every
# archive_cakes row in Supabase points at /archive/<hash>.jpg, so leaving them
# out 404s the proposal pages and search results for everyone but the uploader.

# Reference screenshots from scripts/scrape-vercel-design.mjs. 13 MB of PNGs;
# regenerate with `npm run design:scrape`. The token/component JSON is kept.
/docs/design/shots/
