# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# supabase
supabase/.temp

# typescript
*.tsbuildinfo
next-env.d.ts

# Downscaled copies of the bakery photo archive — regenerate with
# scripts/ingest-archive.mjs --thumbs-only. Too large for git.
/public/archive/

# Reference screenshots from scripts/scrape-vercel-design.mjs. 13 MB of PNGs;
# regenerate with `npm run design:scrape`. The token/component JSON is kept.
/docs/design/shots/
